---
import { t, getLocalizedUrl, type Locale } from '../../i18n';
import AboutTimer from './AboutTimer.astro';
import { mistcraftConfig } from '../../config/mistcraft';
import HomeAboutContact from './HomeAboutContact.astro';
import HomeAboutLinks from './HomeAboutLinks.astro';
import EmailReplyNotice from '../EmailReplyNotice.astro';
import IcpFiling from '../IcpFiling.astro';
import '../../styles/home-about.css';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const prideEggUrl = getLocalizedUrl('/cloud', lang);
---

<section class="fullpage-section home-about" data-index="5" id="section5" aria-labelledby="about-title">
  <div class="about-shell">
    <div class="about-main">
      <div class="about-story">
        <header class="about-heading">
          <div>
            <h2 id="about-title">{t(lang, 'aboutSection.title')}</h2>
            <p class="about-subtitle">{t(lang, 'aboutSection.subtitle')}</p>
          </div>
          <img src={mistcraftConfig.site.logo} alt="MistCraft" width="96" height="66" loading="lazy" decoding="async" class="about-logo" />
        </header>

        <p class="about-description">{t(lang, 'aboutSection.description')}</p>
        <AboutTimer lang={lang} />
        <p class="about-journey">{t(lang, 'aboutSection.journey')}</p>

        <a href={`mailto:${mistcraftConfig.external.contactEmail}`} class="about-email">
          <span class="about-email-copy">
            <span>{t(lang, 'aboutSection.contactUs')}</span>
            <span class="about-email-address">{mistcraftConfig.external.contactEmail}</span>
          </span>
          <span aria-hidden="true">↗</span>
        </a>
        <EmailReplyNotice lang={lang} />
      </div>

      <HomeAboutContact lang={lang} />
    </div>

    <HomeAboutLinks lang={lang} />

    <footer class="about-footer">
      <div class="about-footer-meta">
        <p>{t(lang, 'aboutSection.copyright')}</p>
        <p>{t(lang, 'aboutSection.cdn')}</p>
      </div>
      <p class="about-company">
        <span>{t(lang, 'aboutSection.company')}</span>
        <a href={prideEggUrl} class="pride-easter-egg" aria-label={lang === 'zh' ? '隐藏彩蛋' : 'Hidden easter egg'} title={lang === 'zh' ? '隐藏彩蛋' : 'Hidden easter egg'}>
          <span></span>
        </a>
      </p>
      <IcpFiling />
    </footer>
  </div>
</section>
