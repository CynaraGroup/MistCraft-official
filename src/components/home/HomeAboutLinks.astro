---
import { t, getLocalizedUrl, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<nav class="about-links" aria-label={t(lang, 'aboutSection.otherLinks')}>
  <button type="button" id="members-link" class="about-link" aria-haspopup="dialog" aria-controls="members-modal">
    <svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
    </svg>
    <span class="about-link-copy">
      <span class="about-link-title">{t(lang, 'aboutSection.members')}</span>
      <span class="about-link-description">{t(lang, 'aboutSection.membersDesc')}</span>
    </span>
    <span class="about-link-arrow" aria-hidden="true">↗</span>
  </button>

  <button type="button" id="sponsors-link" class="about-link" aria-haspopup="dialog" aria-controls="sponsors-modal">
    <svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
    </svg>
    <span class="about-link-copy">
      <span class="about-link-title">{t(lang, 'aboutSection.sponsors')}</span>
      <span class="about-link-description">{t(lang, 'aboutSection.sponsorsDesc')}</span>
    </span>
    <span class="about-link-arrow" aria-hidden="true">↗</span>
  </button>

  <a href={getLocalizedUrl('/contact', lang)} class="about-link">
    <svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
    <span class="about-link-copy">
      <span class="about-link-title">{t(lang, 'aboutSection.contactPage')}</span>
      <span class="about-link-description">{t(lang, 'aboutSection.contactPageDesc')}</span>
    </span>
    <span class="about-link-arrow" aria-hidden="true">↗</span>
  </a>
</nav>
