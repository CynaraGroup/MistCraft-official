---
import type { Locale } from '../../i18n';
import PartnersShowcase from '../partners/PartnersShowcase.astro';
import '../../styles/home-partners.css';

interface PartnerItem {
  name: string;
  logo: string;
  url: string;
}

interface Props {
  lang: Locale;
  partners: PartnerItem[];
  limit: number;
  partnersRoute: string;
  contactEmail: string;
}

const { lang, partners, limit, partnersRoute, contactEmail } = Astro.props;
const featuredPartners = partners.slice(0, limit);
---

<section class="fullpage-section home-partners" data-index="3" id="section3" aria-labelledby="home-partners-title">
  <PartnersShowcase lang={lang} partners={featuredPartners} actionHref={partnersRoute} contactEmail={contactEmail} />
</section>
