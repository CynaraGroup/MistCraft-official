---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnersShowcase from '../components/partners/PartnersShowcase.astro';
import partnersData from '../data/partners.json' assert { type: 'json' };
import { getLocalizedUrl, t, type Locale } from '../i18n';
import { mistcraftConfig } from '../config/mistcraft';

interface PartnerItem {
  name: string;
  logo: string;
  url: string;
}

interface Props { lang: Locale }
const { lang } = Astro.props;
const partners = partnersData.partners as PartnerItem[];
const homeRoute = `${getLocalizedUrl(mistcraftConfig.routes.home, lang)}#section3`;
const description = lang === 'zh'
  ? '认识梦幻云创的合作伙伴，访问伙伴网站或联系我们交流合作。'
  : 'Meet MistCraft partners, visit their websites, and get in touch about working together.';
---

<BaseLayout
  title={t(lang, 'nav.partners')}
  lang={lang}
  showVideoBackground={true}
  description={description}
>
  <div class="partners-page">
    <PartnersShowcase lang={lang} partners={partners} actionHref={homeRoute} contactEmail={mistcraftConfig.external.contactEmail} page />
  </div>
</BaseLayout>
